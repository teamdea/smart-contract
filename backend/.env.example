PORT=3000

NODE_ENV=development

# Local JSON-file store (swap to Firestore later; see repositories/*.ts)
DATA_FILE_PATH=

# Daml Sandbox / JSON API (started via `daml start` in ../daml)
DAML_JSON_API_URL=http://localhost:7575
DAML_LEDGER_ID=sandbox
DAML_APPLICATION_ID=programmable-money-backend
DAML_JWT_SECRET=hackathon-dev-secret
DAML_DAR_PATH=

# Shared secret an external logistics/courier system presents to
# POST /oracle/webhook (distinct from the merchant's manual Logistics page button)
LOGISTICS_WEBHOOK_SECRET=hackathon-webhook-secret

# Future: swap the local JSON store for real Firestore once a GCP project exists
FIRESTORE_PROJECT_ID=

FIRESTORE_CLIENT_EMAIL=

FIRESTORE_PRIVATE_KEY=